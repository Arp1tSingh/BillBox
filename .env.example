# ---------------------------------------------------------------------------
# BillBox environment
# Copy the parts you need. Never commit a filled-in env file.
#
# Backend:  copy values into backend/.env, or export them in the shell.
# Frontend: copy the VITE_* values into frontend/.env.local.
# E2E:      copy the whole file to .env.e2e at the repo root.
# ---------------------------------------------------------------------------

# Supabase project (local CLI defaults shown)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret. Leave empty when the project uses asymmetric keys;
# the API then verifies tokens against Supabase JWKS.
SUPABASE_JWT_SECRET=

# Backend
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_HOUSEHOLD_MEMBERS=8

# Gemini (Section 2+; leave empty for local development)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_MOCK=0

# Frontend (Vite only exposes VITE_*)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8000

# E2E harness
API_BASE_URL=http://127.0.0.1:8000
APP_URL=http://127.0.0.1:5173
# Optional: set both to run the deployed smoke test (E2E-1.7)
E2E_DEPLOYED_APP_URL=
E2E_DEPLOYED_API_URL=
