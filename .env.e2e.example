# Copy to .env.e2e at the repo root after `supabase start`.
# `supabase status -o env` prints the keys for ANON_KEY / SERVICE_ROLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

API_BASE_URL=http://127.0.0.1:8000
APP_URL=http://127.0.0.1:5173

# Optional deployed smoke (E2E-1.7)
E2E_DEPLOYED_APP_URL=
E2E_DEPLOYED_API_URL=
